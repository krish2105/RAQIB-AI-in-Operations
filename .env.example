# Copy to .env (gitignored). Every variable is optional for local dev unless marked.

# ---- cloud/ (FastAPI) ----
DATABASE_URL=sqlite:///./raqib.db            # prod: postgresql+psycopg://user:pass@host:5432/postgres (Supabase)
CLIPS_DIR=./clips
CORS_ORIGINS=http://localhost:3000
AGENT_BACKEND=dryrun                         # dryrun | claude
ANTHROPIC_API_KEY=                           # required only when AGENT_BACKEND=claude
AGENT_MODEL=claude-sonnet-4-6
WEEKLY_MODEL=claude-opus-4-1
GREENLAM_URL=                                # e.g. https://greenlam-tracker.onrender.com/api ; empty = work orders recorded locally only
GREENLAM_EMPLOYEE_ID=
GREENLAM_PIN=
ALERT_WEBHOOK_URL=                           # optional sink for send_alert (Slack/Discord/WhatsApp relay)

# ---- v2: zero-cost LLM providers (docs/models.md) ----
LLM_PROVIDER=ollama                          # ollama | gemini | groq | claude ; claude is never chosen implicitly
LLM_PROVIDER_ORDER=ollama,gemini,groq        # free fallback order after LLM_PROVIDER
LLM_PROVIDER_ROUTE=                          # optional per-task override, e.g. groq,ollama (also _ANSWER _CAPTION _OPINION _JUDGE)
LLM_TIMEOUT_S=90
LLM_RPM=10                                   # per-provider minute bucket
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ROUTE=qwen3:4b-instruct
OLLAMA_MODEL_ANSWER=qwen3:8b
OLLAMA_MODEL_JUDGE=qwen3:8b
OLLAMA_MODEL_CAPTION=qwen2.5vl:7b
OLLAMA_MODEL_OPINION=qwen2.5vl:7b
GEMINI_API_KEY=                              # free tier; empty = provider skipped
GEMINI_MODEL_TEXT=gemini-2.5-flash
GEMINI_MODEL_ROUTE=gemini-2.5-flash-lite
GROQ_API_KEY=                                # free tier; empty = provider skipped
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_DAILY_REQUESTS=5000                   # request caps per UTC day; 0 disables the provider
GEMINI_DAILY_REQUESTS=800
GROQ_DAILY_REQUESTS=800
CLAUDE_DAILY_REQUESTS=0

# ---- v2: embeddings and retrieval ----
EMBED_MODEL=ollama:bge-m3:567m               # ollama:<tag> | fastembed:<name> | gemini:<model> | fake:<dim>
EMBED_DIM=1024                               # dimension of chunks.embedding (set once, from docs/models.md)
RERANK_ENABLED=false                         # cross-encoder rerank needs torch; Mac/edge only

# ---- v2: Watch (VLM opinions, camera wall) ----
VLM_AUTO=true                                # second opinion for severity 3 and detector confidence < VLM_AUTO_MAX_CONF once a clip exists
VLM_AUTO_MAX_CONF=0.6
VLM_DAILY_REQUESTS=100
VLM_REVIEW_CONFIDENCE=0.8                    # a confident disagreement asks a human to review; severity is never lowered
STREAM_UPSTREAM=                             # edge MJPEG base, e.g. http://edge-box.lan:8554 ; empty = Watch shows detections only
STREAM_TOKEN=                                # token the edge box requires (raqib-edge run --stream 8554 --stream-token ...)

# ---- v2: auth and RBAC ----
AUTH_REQUIRED=false                          # true: every route needs a Supabase Auth JWT; false: unauthenticated = dev admin (local, demo)
SUPABASE_URL=                                # https://<ref>.supabase.co (JWKS verification)
SUPABASE_JWT_SECRET=                         # legacy HS256 secret; when set it is used instead of JWKS
AUTH_ADMIN_EMAILS=                           # comma list; become admin on first login
AUTH_DEFAULT_ROLE=viewer
RATE_ASK_PER_MIN=20
RATE_VLM_PER_MIN=10

# ---- v2: integrations ----
WHATSAPP_PHONE_ID=                           # WhatsApp Cloud API phone number id; empty = templates are not sent
WHATSAPP_TOKEN=                              # system-user token; approved templates only, never free text
GREENLAM_RETRIES=3                           # tracker POST retries with backoff on 5xx/transport errors
GREENLAM_BREAKER_FAILURES=3                  # consecutive failures that open the circuit
GREENLAM_BREAKER_COOLDOWN_S=60               # seconds before one half-open probe is allowed

# ---- edge/ ----
RAQIB_API_URL=http://localhost:8000
RAQIB_SITE=edge/sites/retail_demo.yaml
RAQIB_DETECTOR=yolo                          # yolo | rtdetr
RAQIB_SOURCE=file                            # file | webcam | rtsp
RAQIB_STREAM_TOKEN=                          # token for --stream; keep the stream off the public internet

# ---- web/ ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=                    # https://<ref>.supabase.co ; empty = the app runs signed out
NEXT_PUBLIC_SUPABASE_ANON_KEY=               # publishable/anon key (safe for the browser)
